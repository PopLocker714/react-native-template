HOST=localhost
PORT=3000
PROTOCOL=http

# S3-compatible storage for hot-updater bundles. Must match the values in
# apps/native/.env.hotupdater. MinIO example below.
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=hotupdate
