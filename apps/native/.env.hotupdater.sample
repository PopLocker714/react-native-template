# Self-hosted update server (standalone repository).
# The CLI records bundle metadata here; the app checks this URL for updates.
HOT_UPDATER_BASE_URL=http://localhost:3000

# S3-compatible storage where bundles are uploaded/served.
# Must match apps/server/.env. MinIO example below (region can be anything,
# endpoint is required for MinIO/R2, forcePathStyle is set in the config).
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=hotupdate

# --- Alternative: Supabase storage (see hot-updater-supabase.config.ts) ---
# HOT_UPDATER_SUPABASE_URL=https://<project>.supabase.co
# HOT_UPDATER_SUPABASE_ANON_KEY=<anon-key>
# HOT_UPDATER_SUPABASE_BUCKET_NAME=hotupdate
