{
	"name": "rn_template",
	"version": "1.0.3",
	"private": true,
	"scripts": {
		"android": "react-native run-android --active-arch-only",
		"ios": "react-native run-ios",
		"lint": "biome lint --write && tsc --noEmit",
		"format": "biome format --write",
		"dev": "react-native start --reset-cache",
		"pod:i": "bunx pod-install ios",
		"pods:nuke": "cd ios && rm -rf Pods && rm -rf Podfile.lock && bundle exec pod install",
		"version:sync": "bun scripts/sync-version.mjs",
		"prerelease:ios": "bunx react-native run-ios --mode Release",
		"rename": "bun scripts/rename-app.mjs",
		"rename:new": "bun run rename -- --name 'MyApp' --package 'com.mycompany.myapp'"
	},
	"dependencies": {
		"@hot-updater/react-native": "0.32.0",
		"@nanostores/persistent": "^1.3.4",
		"@nanostores/react": "^1.1.0",
		"@op-engineering/op-sqlite": "^16.1.1",
		"@react-navigation/elements": "^2.9.19",
		"@react-navigation/native": "^7.2.5",
		"@react-navigation/native-stack": "^7.16.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"immer": "^10.0.0",
		"matrix-js-sdk": "41.6.0",
		"nanostores": "^1.3.0",
		"react": "19.2.6",
		"react-native": "0.85.3",
		"react-native-gesture-handler": "^2.31.2",
		"react-native-get-random-values": "^2.0.0",
		"react-native-gifted-chat": "^3.3.3",
		"react-native-keyboard-controller": "^1.21.8",
		"react-native-nitro-device-info": "^1.7.0",
		"react-native-nitro-modules": "^0.35.7",
		"react-native-quick-base64": "^3.0.0",
		"react-native-quick-crypto": "^1.1.5",
		"react-native-reanimated": "^4.3.1",
		"react-native-safe-area-context": "^5.8.0",
		"react-native-screens": "^4.25.2",
		"react-native-worklets": "^0.8.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/runtime": "^7.29.7",
		"@hot-updater/aws": "0.32.0",
		"@hot-updater/bare": "0.32.0",
		"@hot-updater/standalone": "0.32.0",
		"@react-native-community/cli": "20.1.3",
		"@react-native-community/cli-platform-android": "20.1.3",
		"@react-native-community/cli-platform-ios": "20.1.3",
		"@react-native/babel-preset": "0.85.3",
		"@react-native/codegen": "^0.85.3",
		"@react-native/metro-config": "0.85.3",
		"@react-native/typescript-config": "0.85.3",
		"@types/react": "^19.2.15",
		"babel-plugin-inline-import": "^3.0.0",
		"babel-plugin-module-resolver": "^5.0.3",
		"drizzle-kit": "^0.31.10",
		"hot-updater": "^0.32.0",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">= 22.11.0"
	},
	"op-sqlite": {
		"libsql": true
	}
}