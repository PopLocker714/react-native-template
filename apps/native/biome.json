{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!ios", "!android", "!drizzle", "!.bundle"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"lineWidth": 120
	}
}
